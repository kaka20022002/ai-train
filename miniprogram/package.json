{
  "name": "ai-train-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "AI 健身教练 — 微信小程序（Taro）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass"
