# Adaptive Athletic Risk Assessment — 环境变量模板
# 复制为 .env 后填写（不要把真实密钥提交到 Git）

# ---------- LLM（AI 教练 / 计划生成）----------
USE_REAL_LLM=true
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ---------- 可选：语音识别（小程序 /stt，与 DeepSeek 分开）----------
# WHISPER_API_KEY=
# WHISPER_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1

# ---------- 可选：微信登录（无 Secret 时用开发登录即可）----------
# WECHAT_APPID=
# WECHAT_SECRET=
