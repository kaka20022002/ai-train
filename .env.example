# Adaptive Athletic Risk Assessment — 环境变量模板
# 复制为 .env 后填写（不要把真实密钥提交到 Git）

# ---------- LLM（AI 教练 / 计划生成）----------
USE_REAL_LLM=true
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ---------- 视频动作分析（V-Socrate → 当前 LLM_PROVIDER）----------
# V-Socrate 使用视觉 Qwen/vLLM 提取帧证据；最终回答仍由上面的 DeepSeek 等模型生成。
V_SOCRATE_ENABLED=true
V_SOCRATE_USE_MOCK=false
V_SOCRATE_MODEL=qwen3-vl-8b-instruct
V_SOCRATE_ENDPOINTS=http://127.0.0.1:8200/v1 http://127.0.0.1:8201/v1 http://127.0.0.1:8202/v1 http://127.0.0.1:8203/v1
V_SOCRATE_API_KEY=EMPTY
V_SOCRATE_CLIP_MODEL=/apdcephfs_gy5/share_303098609/hunyuan/jaypernzhou/dev/Videoagent/V-Socrate-1020/models/clip-vit-base-patch32
V_SOCRATE_CACHE_DIR=./.cache/v_socrate
V_SOCRATE_SAMPLE_FPS=1.0
V_SOCRATE_MAX_STEPS=12
V_SOCRATE_MAX_REFLECT_REJECTS=3
# V_SOCRATE_CLIP_FORCE_CPU=false

# 上传限制：默认 100 MiB；视频只写临时文件，请求结束即删除。
VIDEO_MAX_BYTES=104857600
VIDEO_ALLOWED_MIME=video/mp4,video/quicktime,video/webm,video/x-m4v
# VIDEO_TMP_DIR=/tmp/ai-train-video

# ---------- 可选：语音识别（小程序 /stt，与 DeepSeek 分开）----------
# WHISPER_API_KEY=
# WHISPER_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1

# ---------- 可选：微信登录（无 Secret 时用开发登录即可）----------
# WECHAT_APPID=
# WECHAT_SECRET=
